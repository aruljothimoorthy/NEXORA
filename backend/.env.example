# Backend environment variables
# Copy this file to .env and fill in values
# NEVER commit .env to GitHub

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexora
# Set true for local auth testing without installing MongoDB / Atlas
USE_MEMORY_MONGO=true
JWT_SECRET=change_this_to_a_long_random_secret_in_production
# Comma-separated origins allowed for CORS + cookies (use Vercel URL in production)
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# --- Production (Render) example ---
# NODE_ENV=production
# USE_MEMORY_MONGO=false
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/nexora
# JWT_SECRET=use_a_long_random_secret
# CLIENT_URL=https://your-app.vercel.app
# COOKIE_SECURE=true

